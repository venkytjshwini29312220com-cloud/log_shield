# LogShield — copy to .env on each laptop and adjust.
# Laptop 2 (AI engine) is the only server. Do not hard-code IPs in source.

# Bind address for the FastAPI engine (Laptop 2).
# 0.0.0.0 allows other machines on the LAN to connect.
LOGSHIELD_BIND_HOST=0.0.0.0
LOGSHIELD_BIND_PORT=8000

# Reachable IP/hostname of Laptop 2 as seen by Laptop 1 and Laptop 3.
# Example: 192.168.1.20
LOGSHIELD_SERVER_HOST=127.0.0.1
LOGSHIELD_SERVER_PORT=8000

# CORS origins for the SOC dashboard (Laptop 3). Comma-separated.
LOGSHIELD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLite path (relative to backend working directory unless absolute)
LOGSHIELD_DATABASE_URL=sqlite:///./data/logshield.db

# Correlation window in seconds (default 5 minutes)
LOGSHIELD_CORRELATION_WINDOW_SECONDS=300

# Risk weights (must sum to 1.0)
LOGSHIELD_WEIGHT_RULE=0.30
LOGSHIELD_WEIGHT_ML=0.30
LOGSHIELD_WEIGHT_CORRELATION=0.25
LOGSHIELD_WEIGHT_BEHAVIORAL=0.15

# Prototype AI label (shown in UI — this is not a production IDS)
LOGSHIELD_ML_MODEL_LABEL=prototype Isolation Forest anomaly detector
